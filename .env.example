# --- Auth ------------------------------------------------------------------
# Required in production. Use a random value of at least 32 bytes.
CHECKPOINT_JWT_SECRET=
CHECKPOINT_ENV=development
CHECKPOINT_JWT_EXPIRY_HOURS=168

# --- Database ---------------------------------------------------------------
# Leave unset for local SQLite. Production should use managed Postgres.
DATABASE_URL=

# --- Solari -----------------------------------------------------------------
# Production is BYOK: each session supplies its own Solari key.
# Never commit a real key.
SOLARI_API_KEY=
SOLARI_BASE_URL=https://api.getsolari.com
CHECKPOINT_ALLOW_LOCAL_FALLBACK=true

# --- CORS -------------------------------------------------------------------
CHECKPOINT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Resource limits --------------------------------------------------------
CHECKPOINT_MAX_ACTIVE_SESSIONS=3
CHECKPOINT_MAX_ACTIONS_PER_SESSION=100
CHECKPOINT_SESSION_IDLE_TIMEOUT_MIN=30
CHECKPOINT_SESSION_MAX_LIFETIME_MIN=120
CHECKPOINT_CLEANUP_INTERVAL_SEC=60
CHECKPOINT_SOLARI_IDLE_TIMEOUT_MIN=35
CHECKPOINT_MAX_ACTION_INTENT_LENGTH=4000
CHECKPOINT_MAX_COMMAND_LENGTH=12000
CHECKPOINT_MAX_FILE_CONTENT_LENGTH=2000000
CHECKPOINT_MAX_TARGET_LENGTH=1000

# --- Rate limits ------------------------------------------------------------
CHECKPOINT_LOGIN_RATE_MAX=8
CHECKPOINT_LOGIN_RATE_WINDOW_SEC=300
CHECKPOINT_REGISTER_RATE_MAX=5
CHECKPOINT_REGISTER_RATE_WINDOW_SEC=3600
CHECKPOINT_GLOBAL_RATE_MAX=120
CHECKPOINT_GLOBAL_RATE_WINDOW_SEC=60

# Optional LLM demo only
GROQ_API_KEY=
